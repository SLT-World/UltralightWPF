<Window x:Class="UltralightWPF.Example.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UltralightWPF.Example"
        xmlns:ul="clr-namespace:UltralightWPF;assembly=UltralightWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" ThemeMode="System">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <DockPanel Margin="5">
            <Button x:Name="BackButton" ToolTip="Back" Height="36" Margin="0,0,5,0" Click="BackButton_Click">
                <Button.Content>
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xe72b;"/>
                </Button.Content>
            </Button>
            <Button x:Name="ForwardButton" ToolTip="Forward" Height="36" Margin="0,0,5,0" Click="ForwardButton_Click">
                <Button.Content>
                    <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xe72a;"/>
                </Button.Content>
            </Button>
            <Button x:Name="RefreshButton" ToolTip="Refresh" Height="36" Margin="0,0,5,0" Click="RefreshButton_Click">
                <Button.Content>
                    <TextBlock x:Name="RefreshButtonIcon" FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xe72c;"/>
                </Button.Content>
            </Button>
            <TextBox x:Name="AddressBox" Margin="0,0,0,0" Height="36" FontSize="14" VerticalContentAlignment="Center" KeyDown="AddressBox_KeyDown"/>
        </DockPanel>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>-->
        <!--<ul:UltralightWebView x:Name="BrowserView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto"/>-->
        <ul:UltralightHwndWebView Grid.Row="1" x:Name="BrowserView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto"/>
        <!--<ul:UltralightWebView Grid.Column="1" Visibility="Collapsed" x:Name="InspectorView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="Auto" Width="Auto"/>-->
    </Grid>
</Window>
